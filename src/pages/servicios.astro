---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { site, services } from '../data/site';
import { serviceSchema, breadcrumbSchema } from '../data/schema';

/**
 * Servicios hub. The practice offers two therapies — individual (her specialty)
 * and pareja — each with its own detail page. This page is the overview that
 * links to both. Kept deliberately light so it doesn't compete with the detail
 * pages for the "terapia X en Granada" searches.
 */
---

<Base
  title="Servicios | Terapia psicológica en Granada — Cintia Barranco"
  description="Terapia individual y de pareja en Granada, presencial y online. Elige el acompañamiento que encaja contigo. Escríbeme sin compromiso."
  path="/servicios"
  loaderName="Servicios"
  jsonld={[
    ...services.map((s) => serviceSchema(s)),
    breadcrumbSchema([
      { name: 'Inicio', path: '/' },
      { name: 'Servicios', path: '/servicios' },
    ]),
  ]}
>
  <header class="shell-narrow head">
    <div data-rv>
      <div class="kicker"><span class="rule"></span>Terapia psicológica · Granada</div>
      <h1 class="h1-sm">Un acompañamiento para cada momento</h1>
      <p class="lead">
        Trabajo la terapia individual —mi especialidad, centrada en los vínculos y las
        relaciones— y la terapia de pareja. Elige por dónde quieres empezar; si dudas, escríbeme y
        lo vemos juntas.
      </p>
    </div>
  </header>

  <section class="shell hub">
    <div class="grid-2" data-rv>
      {
        services.map((s) => (
          <a class="scard" href={s.path}>
            <div class="scard-media">
              <Photo
                name={s.photo}
                alt={s.alt}
                variant="photo-wide"
                sizes="(max-width: 760px) 100vw, 46vw"
              />
            </div>
            <div class="scard-body">
              <div class="italic scard-kicker">{s.kicker}</div>
              <h2>{s.title}</h2>
              <p>{s.short}</p>
              <span class="pill-meta">{s.meta}</span>
              <span class="arrow scard-cta">Ver más →</span>
            </div>
          </a>
        ))
      }
    </div>

    <div class="hub-cta" data-rv>
      <a href={site.whatsapp} target="_blank" rel="noopener" class="btn btn-solid">
        Escríbeme por WhatsApp
      </a>
      <a href="/contacto" class="soft">¿Prefieres el formulario? Pide cita aquí →</a>
    </div>
  </section>
</Base>

<style>
  .head {
    text-align: center;
    padding-top: clamp(56px, 8vw, 86px);
    padding-bottom: clamp(32px, 5vw, 56px);
  }
  .head .lead {
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: 0;
  }

  .hub {
    padding-bottom: clamp(68px, 10vw, 128px);
  }

  .scard {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid rgba(153, 111, 252, 0.2);
    box-shadow: var(--lift);
    border-radius: var(--card-lg);
    overflow: hidden;
    color: var(--ink);
    transition:
      transform 0.42s var(--ease),
      box-shadow 0.42s var(--ease),
      border-color 0.42s var(--ease);
  }
  .scard:hover {
    transform: translateY(-6px);
    box-shadow: var(--lift-hi);
    border-color: var(--edge-2);
    color: var(--ink);
  }
  .scard-media :global(.photo) {
    border-radius: 0;
    aspect-ratio: 16 / 10;
  }
  .scard-body {
    padding: clamp(26px, 3vw, 34px) clamp(24px, 2.8vw, 32px) clamp(28px, 3vw, 34px);
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .scard-kicker {
    font-size: 16px;
    margin-bottom: 8px;
  }
  .scard h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(24px, 2.8vw, 30px);
    margin: 0 0 12px;
  }
  .scard p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--body);
    margin: 0 0 18px;
  }
  .scard .pill-meta {
    align-self: flex-start;
    margin-bottom: 22px;
  }
  .scard-cta {
    margin-top: auto;
  }

  .hub-cta {
    margin-top: clamp(40px, 6vw, 56px);
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .soft {
    font-size: 15px;
    font-weight: 600;
  }
</style>
