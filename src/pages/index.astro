---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Faq from '../components/Faq.astro';
import Ambient from '../components/Ambient.astro';
import WhatsappBand from '../components/WhatsappBand.astro';
import { site, services, focusAreas, individualConcerns } from '../data/site';
import { faqSchema, serviceSchema } from '../data/schema';
import { fmtDate } from '../lib/format';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

// FAQ copy from Cintia (PDF, 2026-10). Answer #2 carries an inline link to the
// blog post — rendered via set:html in Faq.astro.
const faqs = [
  {
    q: '¿Cómo empiezo la terapia?',
    a: 'Escríbeme por WhatsApp y cuéntame, con tus palabras, qué te preocupa. Te respondo personalmente y resolvemos tus dudas antes de empezar. Después, en la primera sesión, hablamos con calma de lo que te ha traído hasta aquí.',
  },
  {
    q: '¿Cómo sé si necesito ir al psicólogo?',
    a: 'No hace falta estar en un momento de crisis. Si algo te hace sufrir, te pesa o se repite en tu vida y no consigues resolverlo solo o sola, merece la pena hablarlo. Si tienes dudas, en <a href="/blog/cuando-ir-al-psicologo/">este artículo te cuento las señales que no conviene ignorar</a>.',
  },
  {
    q: '¿Puedo ir a terapia por una ruptura?',
    a: 'Sí, es uno de los motivos más habituales. Una ruptura no es solo perder a una persona: también remueve tu autoestima, tu forma de vincularte y tu idea de futuro. En terapia te acompaño a entender qué ha pasado, a procesarlo y a reconstruirte a tu ritmo.',
  },
  {
    q: '¿Las sesiones son presenciales u online?',
    a: 'Ambas. Puedes venir a mi consulta en C/ El Guerra, 17, Beiro (Granada) o hacer las sesiones por videollamada segura. La terapia online funciona igual de bien y te permite hacerla desde donde te sientas cómodo/a.',
  },
  {
    q: '¿Cuánto cuesta una sesión de psicología?',
    a: 'La sesión individual cuesta 65 € y dura aproximadamente unos 75-90 minutos. Si lo prefieres, escríbeme sin compromiso y de manera gratuita, y te explico las modalidades para que decidas con toda la información.',
  },
  {
    q: '¿Cuántas sesiones necesitaré?',
    a: 'Depende de lo que quieras trabajar y de tu situación; no hay un número fijo. Al principio marcamos unos objetivos juntos y los vamos revisando. Cuando sientas que ya no necesitas que sigamos, lo dejamos, y siempre que lo necesites puedes volver.',
  },
  {
    q: '¿Qué son las terapias conductuales-contextuales?',
    a: 'Es un enfoque que entiende lo que haces, sientes y piensas en relación con tu historia de vida y con lo que ocurre a tu alrededor. No te etiqueta ni busca «qué tienes mal»: mira qué te ha llevado a actuar como actúas y qué mantiene eso hoy. Por ejemplo, te ayuda a entender por qué sigues en un vínculo que te hace daño o por qué te cuesta priorizarte. No se trata de juzgarte, sino de entender qué te sirve y qué te aleja de lo que te importa, para que puedas elegir cómo quieres vivir tus relaciones. Entenderlo es lo que permite cambiarlo, y que lo trabajado en consulta se note en tu vida diaria.',
  },
  {
    q: '¿Es confidencial lo que hablamos?',
    a: 'Totalmente. Todo lo que compartas está protegido por el secreto profesional y por el código deontológico del Colegio Oficial de Psicología.',
  },
] as const;

const marquee = [
  'Rupturas',
  'Vínculos y relaciones',
  'Autoestima',
  'Dependencia emocional',
  'Ansiedad',
  'Duelo',
  'Cambios vitales',
];
---

<Base
  title="Psicóloga en Granada y online | Rupturas, vínculos y autoestima"
  description="Terapia psicológica en Granada y online. Te acompaño en tus relaciones, rupturas y autoestima, a tu ritmo y sin juicios, desde un enfoque conductual-contextual. Escríbeme sin compromiso."
  path="/"
  jsonld={[faqSchema(faqs), ...services.map((s) => serviceSchema(s))]}
>
  <!-- ------------------------------------------------------------- hero -- -->
  <div class="hero-wrap">
    <Ambient variant="hero" />
    <header class="shell hero">
    <div>
      <div class="kicker"><span class="rule"></span>Psicóloga General Sanitaria · Granada y online</div>
      <h1 class="h1">Un espacio seguro para empezar a entenderte y construir el cambio</h1>
      <p class="lead hero-lead">
        Te acompaño a entenderte, superar rupturas y construir relaciones más sanas, empezando por la
        que tienes contigo mismo/a. A tu ritmo, sin juicios pero con el acompañamiento de una
        psicóloga general sanitaria.
      </p>
      <div class="btns">
        <a href={site.whatsapp} target="_blank" rel="noopener" class="btn btn-solid">Escríbeme por WhatsApp</a>
        <a href="/servicios" class="btn btn-ghost">Ver servicios</a>
      </div>
    </div>

    <div class="hero-media">
      <Photo
        name="cintia-retrato"
        alt="Cintia Barranco, psicóloga en Granada"
        variant="photo-hero"
        sizes="(max-width: 760px) 100vw, 430px"
        priority
      />
      <div class="badge">
        <span class="live" aria-hidden="true"></span>
        <span>Disponible presencial y online</span>
      </div>
    </div>
    </header>

    {/* Now that the hero is shorter, the page can look like it ends at the fold. */}
    <a class="cue" href="#sobre-mi">
      <span class="cue-txt">Descubre más</span>
      <span class="cue-line" aria-hidden="true"></span>
    </a>
  </div>

  <!-- ---------------------------------------------------------- marquee -- -->
  <div class="marquee" aria-hidden="true">
    <div class="track">
      {
        [0, 1].map(() => (
          <div class="run">
            {marquee.map((w) => (
              <>
                <span>{w}</span>
                <span>·</span>
              </>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <!-- --------------------------------------------------- conoce a tu ... -- -->
  {/* Cintia asked to lead with "Conoce a tu psicóloga" before the concern list —
      people meet her first, then read what she works with. Sits on the page
      background (not a white band) so it contrasts with the white marquee above
      and the white concern list below. */}
  <section class="amb about-top" id="sobre-mi">
    <Ambient />
    <div class="shell sect duo">
      <div data-rv>
        <Photo
          name="cintia-consulta"
          alt="Cintia Barranco González, psicóloga sanitaria en Granada"
          variant="photo-tall"
          sizes="(max-width: 760px) 100vw, 430px"
        />
      </div>

      <div data-rv>
        <div class="kicker">Conoce a tu psicóloga</div>
        <h2 class="h2 mb">Soy Cintia Barranco</h2>
        <p class="prose mb-sm">
          Psicóloga general sanitaria, especializada en rupturas, vínculos y autoestima. Ayudo a
          personas que atraviesan una ruptura, que repiten los mismos patrones en sus relaciones con
          los demás haciéndoles sufrir o que quieren recuperar la confianza en sí mismas. Consulta en
          Granada y también online.
        </p>
        <p class="prose mb">
          Trabajo desde el enfoque conductual-contextual: en lugar de centrarnos solo en qué te pasa,
          miramos cómo y por qué te relacionas con los demás y contigo de la manera en que lo haces,
          para que puedas elegir cómo quieres vivir tus relaciones y avanzar hacia lo que de verdad te
          importa. Para que lo que trabajamos en consulta se note en tu vida real.
        </p>

        <div class="pills mb">
          {focusAreas.map((a) => <span class="pill">{a}</span>)}
        </div>

        <div class="creds">
          <div><span class="dot" aria-hidden="true">✓</span>Psicóloga General Sanitaria colegiada (nº {site.colegiada})</div>
          <div><span class="dot" aria-hidden="true">✓</span>Máster en Psicología General Sanitaria</div>
          <div><span class="dot" aria-hidden="true">✓</span>Especialista en terapias conductuales y contextuales</div>
        </div>

        <a href="/sobre-mi" class="btn btn-solid btn-sm">Conóceme mejor</a>
      </div>
    </div>
  </section>

  <!-- --------------------------------------------------- servicios (light) -- -->
  {/* Home only introduces the services; the depth lives on each detail page
      (Cintia: "en la página principal también hablaría de pareja y familiar,
      aunque no se indague tanto como en la individual"). */}
  <section class="shell sect amb servicios-home" id="servicios">
    <Ambient />
    <div class="center-head" data-rv>
      <div class="kicker">Mis servicios</div>
      <h2 class="h2">¿En qué puedo acompañarte?</h2>
      <p class="note center-note">
        Mi especialidad es la terapia individual, centrada en rupturas, vínculos y autoestima.
        También acompaño a parejas y familias cuando lo que se necesita es cuidar el vínculo entre
        ellas.
      </p>
    </div>

    {/* Individual therapy leads as the specialty. On the home page we only list
        the motivos as titles (chips) — the detail page is where they're explained
        (Cintia: "en la principal... aunque no se indague tanto como en la individual"). */}
    <div class="indiv" data-rv>
      <span class="tagline">Especialidad</span>
      <h3 class="indiv-title">{services[0].title}</h3>
      <p class="indiv-short">{services[0].short}</p>
      <ul class="motivos" aria-label="Motivos de consulta en terapia individual">
        {
          individualConcerns.map((c) => (
            <li class:list={['motivo', { feat: 'featured' in c && c.featured }]}>{c.t}</li>
          ))
        }
      </ul>
      <a href={services[0].path} class="btn btn-solid indiv-cta">Ver terapia individual →</a>
    </div>
  </section>

  {/* The other two therapies, lighter, in their own section below. */}
  <section class="shell sect otras" id="mas-servicios">
    <div class="center-head" data-rv>
      <div class="kicker">Otros acompañamientos</div>
      <h2 class="h2">Terapia de pareja y familiar</h2>
    </div>

    <div class="grid-2 otras-grid" data-rv>
      {
        services.slice(1).map((s) => (
          <a class="card svc-card" href={s.path}>
            <h3>{s.title}</h3>
            <p>{s.short}</p>
            <span class="arrow">Ver más →</span>
          </a>
        ))
      }
    </div>
  </section>

  <WhatsappBand />

  <!-- ---------------------------------------------------------- proceso -- -->
  <section class="shell sect" id="proceso">
    <div class="center-head" data-rv>
      <div class="kicker">Cómo trabajaremos</div>
      <h2 class="h2">Así es la terapia conmigo, paso a paso</h2>
    </div>

    <div class="grid-2 proceso-grid">
      <div class="step" data-rv>
        <div class="num">01<span class="emo" aria-hidden="true">👋</span></div>
        <h3 class="h3">Primer contacto</h3>
        <p>
          Cuéntame con tus palabras qué te trae por aquí. Te respondo personalmente y resolvemos tus
          dudas antes de empezar. Sin presión.
        </p>
      </div>
      <div class="step" data-rv>
        <div class="num">02<span class="emo" aria-hidden="true">💬</span></div>
        <h3 class="h3">Primera sesión</h3>
        <p>
          Me cuentas con mayor profundidad qué te ha motivado a pedir ayuda. Ya en este primer
          encuentro vamos empezando a entender qué te está pasando. En mi consulta de Granada o por
          videollamada, donde te sientas más cómodo/a.
        </p>
      </div>
      <div class="step" data-rv>
        <div class="num">03<span class="emo" aria-hidden="true">🎯</span></div>
        <h3 class="h3">Proceso terapéutico</h3>
        <p>
          Fijamos unos objetivos a tu medida y trabajamos hacia ellos sesión a sesión, para aliviar
          lo que te hace sufrir y que los cambios se noten en tu día a día.
        </p>
      </div>
      <div class="step" data-rv>
        <div class="num">04<span class="emo" aria-hidden="true">🤝</span></div>
        <h3 class="h3">Cierre del proceso</h3>
        <p>
          Cuando hayamos conseguido lo que nos propusimos y sientas que ya no necesitas que sigamos,
          damos por cerrado el proceso. No es una despedida definitiva: si más adelante la vida te
          trae un momento difícil, aquí estaré para retomar el trabajo juntos/as.
        </p>
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------------- blog -- -->
  {
    posts.length > 0 && (
      <section class="band" id="blog">
        <div class="shell sect">
          <div class="sect-head tight" data-rv>
            <div>
              <div class="kicker">Del blog</div>
              <h2 class="h2">Recursos para tu bienestar</h2>
            </div>
            <a href="/blog" class="arrow">Ver todos los artículos →</a>
          </div>

          <div class="rows" data-rv>
            {posts.map((p) => (
              <a class="row" href={`/blog/${p.id}`}>
                <span class="row-cat">{p.data.category}</span>
                <span class="row-title">{p.data.title}</span>
                <span class="row-date">{fmtDate(p.data.date)} →</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- --------------------------------------------------------- contacto -- -->
  <section class="shell sect" id="contacto" data-rv>
    <div class="slab slab-duo">
      <div>
        <h2>Si algo te duele, no tienes que cargarlo en silencio.</h2>
        <p>
          Una primera conversación para conocernos y resolver tus dudas. Después, tú decides si
          seguimos adelante.
        </p>
        <div class="btns">
          <a href={site.whatsapp} target="_blank" rel="noopener" class="btn btn-light">
            Escríbeme por WhatsApp
          </a>
          <a href={`tel:${site.phone}`} class="btn btn-outline-light">{site.phoneDisplay}</a>
        </div>
      </div>

      <div class="meta-list">
        <div>
          <div class="meta-label">Consulta</div>
          {site.street}, {site.district}<br />{site.postal} {site.city}
        </div>
        <div>
          <div class="meta-label">Email</div>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </div>
        <div>
          <div class="meta-label">Instagram</div>
          <a href={site.instagram} target="_blank" rel="noopener">{site.instagramHandle}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ---------------------------------------------------------------faq -- -->
  <section class="band-top">
    <div class="shell-narrow sect-sm">
      <Faq items={faqs} kicker="Preguntas frecuentes" heading="Preguntas frecuentes sobre la terapia" />
    </div>
  </section>
</Base>

<style>
  /* ---------------------------------------------------------- ambient -- */
  /* The blob layer is absolutely positioned, so every host needs a positioning
     context and its own content lifted above it. */
  .hero-wrap,
  .amb {
    position: relative;
  }
  .hero-wrap > .shell,
  .hero-wrap > .cue,
  .amb > *:not(.ambient) {
    position: relative;
    z-index: 1;
  }

  /* ------------------------------------------------------------- cue -- */
  .cue {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding-bottom: 28px;
    color: var(--muted);
  }
  .cue:hover {
    color: var(--brand-light);
  }
  .cue-txt {
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    font-weight: 600;
  }
  /* A hairline with a travelling highlight — reads as "keep going" without an
     arrow glyph that would fight the serif type. */
  .cue-line {
    position: relative;
    width: 1px;
    height: 46px;
    background: var(--line-2);
    overflow: hidden;
  }
  .cue-line::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: -60%;
    height: 60%;
    background: linear-gradient(to bottom, transparent, var(--brand-light));
    animation: cueRun 2.2s cubic-bezier(0.5, 0, 0.5, 1) infinite;
  }
  @keyframes cueRun {
    to {
      top: 100%;
    }
  }

  /* ------------------------------------------------------------- hero -- */
  .hero {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(36px, 5vw, 64px);
    align-items: center;
    padding-top: clamp(56px, 8vw, 76px);
    padding-bottom: clamp(48px, 6vw, 70px);
  }
  .hero-lead {
    max-width: 520px;
  }
  .hero-media {
    position: relative;
  }

  .badge {
    position: absolute;
    left: clamp(-12px, -2vw, -28px);
    bottom: 36px;
    background: var(--surface);
    border: 1px solid var(--edge-2);
    border-radius: 16px;
    padding: 14px 20px;
    box-shadow: 0 18px 45px -12px rgba(43, 40, 64, 0.5);
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: clamp(13px, 1.4vw, 15px);
    font-weight: 700;
    color: var(--ink);
    animation: floatY 5s ease-in-out infinite;
  }
  .live {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--ok);
    flex-shrink: 0;
  }
  @keyframes floatY {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  /* ---------------------------------------------------------- marquee -- */
  .marquee {
    overflow: hidden;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 18px 0;
    background: var(--surface);
  }
  .track {
    display: flex;
    white-space: nowrap;
    width: max-content;
    animation: marquee 30s linear infinite;
  }
  .run {
    display: flex;
    gap: clamp(28px, 5vw, 56px);
    padding-right: clamp(28px, 5vw, 56px);
    font-family: var(--serif);
    font-size: clamp(16px, 2vw, 20px);
    font-style: italic;
    color: var(--brand-light);
  }
  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* 4-step process as a 2×2 grid (step 4 is long; a row of 4 would be lopsided). */
  .proceso-grid {
    gap: clamp(32px, 4vw, 52px) clamp(32px, 5vw, 64px);
  }

  /* ----------------------------------------------------------- blocks -- */
  .sect-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    margin-bottom: 56px;
  }
  .sect-head.tight {
    margin-bottom: 40px;
  }
  .sect-note {
    font-size: 16px;
    line-height: 1.6;
    color: var(--body);
    max-width: 400px;
    margin: 0;
  }
  .center-head {
    text-align: center;
    margin-bottom: clamp(40px, 6vw, 64px);
  }
  .center-note {
    max-width: 620px;
    margin: 0 auto;
    font-size: 16px;
  }

  /* Light services overview — position context for the ambient layer. */
  .servicios-home {
    position: relative;
  }
  .svc-card {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .svc-card .arrow {
    margin-top: auto;
  }
  .svc-card .tagline {
    position: absolute;
    top: 18px;
    right: 18px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--brand-dark);
    background: var(--tint);
    border-radius: 999px;
    padding: 5px 12px;
  }
  .svc-kicker {
    font-size: 15px;
    margin-bottom: 8px;
  }
  .svc-card h3 {
    font-size: clamp(20px, 2vw, 24px);
    margin-bottom: 12px;
  }
  .svc-card p {
    margin-bottom: 20px;
  }

  /* Featured individual-therapy panel: title + short + motivos as chips. */
  .indiv {
    position: relative;
    max-width: 900px;
    margin-inline: auto;
    background: var(--surface);
    border: 1px solid rgba(153, 111, 252, 0.2);
    box-shadow: var(--lift);
    border-radius: var(--card-lg);
    padding: clamp(30px, 4vw, 52px);
  }
  .indiv .tagline {
    display: inline-block;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--brand-dark);
    background: var(--tint);
    border-radius: 999px;
    padding: 5px 12px;
    margin-bottom: 14px;
  }
  .indiv-title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(25px, 3.2vw, 34px);
    margin: 0 0 12px;
  }
  .indiv-short {
    font-size: clamp(15px, 1.6vw, 17px);
    line-height: 1.6;
    color: var(--body);
    max-width: 640px;
    margin: 0 0 clamp(22px, 3vw, 28px);
  }

  /* Motivos as titles only — a chip cloud. The five she wants to be known for
     are filled; the rest are outlined. No descriptions here (that's the detail page). */
  .motivos {
    list-style: none;
    margin: 0 0 clamp(26px, 3.4vw, 34px);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .motivo {
    font-size: 14px;
    line-height: 1;
    padding: 9px 15px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    color: var(--body);
    background: var(--surface);
  }
  .motivo.feat {
    background: var(--tint);
    border-color: transparent;
    color: var(--brand-dark);
    font-weight: 600;
  }
  .indiv-cta {
    margin-top: 2px;
  }

  /* Pareja + familiar: two lighter cards, centred under their own heading. */
  .otras-grid {
    max-width: 760px;
    margin-inline: auto;
  }

  .trip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    padding-block: clamp(40px, 6vw, 70px);
  }
  .trip :global(.offset) {
    margin-top: 32px;
  }

  .mb {
    margin-bottom: 24px;
  }
  .mb-sm {
    margin-bottom: 18px;
  }

  /* Emoji sits on the baseline of the big serif numeral, warming up what is
     otherwise the coldest section on the page. */
  .step .num {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }
  .emo {
    font-size: 26px;
    line-height: 1;
    /* Colour emoji ignore the numeral's tint; give it its own gentle motion. */
    animation: emoBob 4.5s ease-in-out infinite;
  }
  .step:nth-child(2) .emo {
    animation-delay: 0.6s;
  }
  .step:nth-child(3) .emo {
    animation-delay: 1.2s;
  }
  @keyframes emoBob {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-5px) rotate(-6deg);
    }
  }

  .creds {
    display: grid;
    gap: 12px;
    margin-bottom: 32px;
