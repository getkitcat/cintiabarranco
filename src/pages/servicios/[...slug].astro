---
import Base from '../../layouts/Base.astro';
import ServiceBlock from '../../components/ServiceBlock.astro';
import TherapySignals from '../../components/TherapySignals.astro';
import ConcernList from '../../components/ConcernList.astro';
import Faq from '../../components/Faq.astro';
import { site, services } from '../../data/site';
import { serviceSchema, faqSchema, breadcrumbSchema } from '../../data/schema';

/**
 * One page per therapy, at the Granada ranking URLs the Framer site used
 * (/servicios/terapia-individual-en-granada, …). /servicios is the hub that links
 * here. Individual (her focus) gets the signals + "lo que ganas" block; pareja and
 * familiar get their own signs list + reasons + FAQ.
 */
export function getStaticPaths() {
  return services.map((s) => ({
    params: { slug: s.path.replace('/servicios/', '') },
    props: { service: s },
  }));
}

const { service: s } = Astro.props;
const others = services.filter((o) => o.slug !== s.slug);
const isIndividual = s.slug === 'terapia-individual';

// Shared — the case for therapy applies to both.
const reasons = [
  { h: 'Claridad', p: 'Entender qué sientes, por qué lo sientes y cómo influye en tu día a día.' },
  { h: 'Herramientas prácticas', p: 'Recursos basados en evidencia que puedes aplicar en tu vida cotidiana.' },
  { h: 'Relaciones más sanas', p: 'Comunicar mejor, poner límites y construir vínculos más auténticos.' },
  { h: 'Espacio seguro', p: 'Un lugar libre de juicios donde poder ser con total honestidad, a tu ritmo.' },
  { h: 'Autoconocimiento', p: 'Descubrir patrones que limitan y desarrollar una relación más amable contigo.' },
  { h: 'Cambio duradero', p: 'No buscamos soluciones rápidas: construimos un bienestar que se mantenga.' },
];

const faqsBySlug: Record<string, readonly { q: string; a: string }[]> = {
  'terapia-individual': [
    {
      q: '¿Cuánto dura cada sesión?',
      a: 'Las sesiones duran unos 50 minutos, pensadas para trabajar en profundidad sin que resulte agotador.',
    },
    {
      q: '¿Cuántas sesiones necesitaré?',
      a: 'Depende de cada persona y de los objetivos que establezcamos juntas. Algunas personas notan mejoras significativas en 8–12 sesiones; otras prefieren un acompañamiento más largo.',
    },
    {
      q: '¿Presencial u online, qué diferencia hay?',
      a: 'La calidad terapéutica es la misma en ambos formatos. La terapia online se realiza por videollamada segura.',
    },
    {
      q: '¿Trabajas con seguros médicos?',
      a: 'Actualmente trabajo como profesional privada. Puedo proporcionarte facturas que algunos seguros reembolsan.',
    },
    {
      q: '¿Qué pasa si necesito cancelar una cita?',
      a: 'Solo te pido que me avises con al menos 24 horas de antelación para poder reorganizar la agenda.',
    },
  ],
  'terapia-pareja': [
    {
      q: '¿Tenemos que ir siempre los dos?',
      a: 'La terapia de pareja se trabaja con ambos miembros, porque el foco es la relación. En algún momento del proceso puede haber sesiones individuales si tiene sentido, pero siempre lo hablamos antes.',
    },
    {
      q: '¿Y si uno de los dos no está muy convencido?',
      a: 'Es más habitual de lo que parece. No hace falta llegar con todo claro; a veces basta con la disposición a intentarlo. En la primera sesión vemos juntos si es el momento y el espacio adecuado.',
    },
    {
      q: '¿La terapia de pareja es solo para crisis?',
      a: 'No. Ayuda en momentos difíciles, pero también cuando queréis cuidar la relación, mejorar la comunicación o atravesar un cambio importante antes de que se convierta en un problema.',
    },
    {
      q: '¿Cuánto dura cada sesión?',
      a: 'Entre 60 y 90 minutos, para dar espacio a los dos sin prisa. Suelen ser quincenales, aunque lo ajustamos a lo que necesitéis.',
    },
    {
      q: '¿Presencial u online?',
      a: 'Ambas. Podéis venir a la consulta en Granada o hacer las sesiones por videollamada segura, con la misma calidad terapéutica.',
    },
  ],
  'terapia-familiar': [
    {
      q: '¿Tiene que venir toda la familia?',
      a: 'No siempre. A veces trabajamos con toda la familia y otras con subgrupos (por ejemplo, madres/padres e hijos), según lo que necesite cada caso. Lo vamos ajustando durante el proceso.',
    },
    {
      q: '¿Sirve si el problema parece ser solo de una persona?',
      a: 'Sí. Desde una mirada sistémica, lo que le pasa a un miembro suele estar conectado con la dinámica de toda la familia. Trabajar juntos ayuda a que el cambio se sostenga.',
    },
    {
      q: '¿Trabajáis con adolescentes?',
      a: 'Sí. La terapia familiar es especialmente útil cuando hay tensión entre padres e hijos adolescentes o dificultades de comunicación en casa.',
    },
    {
      q: '¿Cuánto dura cada sesión?',
      a: 'Entre 60 y 90 minutos, para dar espacio a las distintas voces de la familia sin prisa.',
    },
    {
      q: '¿Presencial u online?',
      a: 'La terapia familiar funciona mejor de forma presencial en la consulta de Granada, aunque podemos valorar sesiones online si la situación lo requiere.',
    },
  ],
};
const faqs = faqsBySlug[s.slug];
---

<Base
  title={`${s.title} en Granada | Cintia Barranco, Psicóloga`}
  description={s.body.slice(0, 155)}
  path={s.path}
  loaderName={s.title}
  jsonld={[
    serviceSchema(s),
    faqSchema(faqs),
    breadcrumbSchema([
      { name: 'Inicio', path: '/' },
      { name: 'Servicios', path: '/servicios' },
      { name: s.title, path: s.path },
    ]),
  ]}
>
  <nav class="shell crumbs" aria-label="Ruta de navegación">
    <a href="/">Inicio</a>
    <span aria-hidden="true">/</span>
    <a href="/servicios">Servicios</a>
    <span aria-hidden="true">/</span>
    <span class="here">{s.title}</span>
  </nav>

  <ServiceBlock service={s} as="h1" linkOut={false} label="El acompañamiento" showSigns={!isIndividual} />

  {/* Individual (her focus): the reference-style signals + gains hook, then the
      detailed table of motivos (expand each for specifics). Pareja/familiar get
      the shared reasons grid below instead. */}
  {isIndividual && <TherapySignals />}
  {
    isIndividual && (
      <ConcernList
        variant="table"
        anchorId="tabla-motivos"
        kicker="Motivos de consulta"
        heading="¿Con qué puedo ayudarte?"
      />
    )
  }

  {
    !isIndividual && (
      <section class="band-top">
        <div class="shell sect">
          <div class="center-head" data-rv>
            <div class="kicker">¿Por qué la terapia?</div>
            <h2 class="h2-sm">Lo que podéis ganar</h2>
          </div>
          <div class="grid-3 reasons" data-rv>
            {reasons.map((r) => (
              <div class="step no-num">
                <h3 class="h3">{r.h}</h3>
                <p>{r.p}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- --------------------------------------------------------------- faq -- -->
  <section class="shell-narrow sect">
    <Faq items={faqs} heading="Todo lo que necesitas saber antes de empezar" />
  </section>

  <!-- ------------------------------------------------------------ otras -- -->
  <section class="band-top">
    <div class="shell sect-sm">
      <div class="center-head" data-rv>
        <div class="kicker">Otras terapias</div>
        <h2 class="h2-sm">¿Buscabas otra cosa?</h2>
      </div>
      <div class="grid-2 others" data-rv>
        {
          others.map((o) => (
            <a class="card" href={o.path}>
              <div class="italic o-kicker">{o.kicker}</div>
              <h3>{o.title}</h3>
              <p>{o.short}</p>
              <span class="arrow">Ver {o.title} →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .crumbs {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
    font-size: 13px;
    color: var(--muted);
    padding-top: clamp(24px, 4vw, 40px);
  }
  .crumbs a {
    color: var(--muted);
  }
  .crumbs a:hover {
    color: var(--brand);
  }
  .here {
    color: var(--ink);
    font-weight: 600;
  }

  .center-head {
    text-align: center;
    margin-bottom: 44px;
  }
  .reasons {
    gap: 40px 48px;
  }
  .no-num {
    padding-top: 22px;
  }
  .no-num h3 {
    font-size: clamp(19px, 1.8vw, 21px);
    margin-bottom: 10px;
  }

  .others {
    max-width: 820px;
    margin-inline: auto;
  }
  .o-kicker {
    font-size: 16px;
    margin-bottom: 8px;
  }

  @media (max-width: 900px) {
    .reasons {
      grid-template-columns: 1fr 1fr;
      gap: 28px 32px;
    }
  }
  @media (max-width: 600px) {
    .reasons {
      grid-template-columns: 1fr;
    }
  }
</style>
