---
import Base from '../../layouts/Base.astro';
import ServiceBlock from '../../components/ServiceBlock.astro';
import ConcernList from '../../components/ConcernList.astro';
import { site, services } from '../../data/site';
import { serviceSchema, breadcrumbSchema } from '../../data/schema';

/**
 * One page per therapy, at the exact paths the Framer site already ranks on
 * (/servicios/terapia-individual-en-granada, …). The prototype collapsed all four
 * into anchors on /servicios; doing that would have retired four URLs already
 * targeting "terapia X en Granada", which is the highest-intent local search this
 * practice has. The hub still shows every block, so the design is unchanged —
 * these pages give each therapy its own indexable, linkable home.
 */
export function getStaticPaths() {
  return services.map((s) => ({
    // `path` is the full route; strip the /servicios/ prefix for the rest param.
    params: { slug: s.path.replace('/servicios/', '') },
    props: { service: s },
  }));
}

const { service: s } = Astro.props;
const others = services.filter((o) => o.slug !== s.slug);
---

<Base
  title={`${s.title} en Granada | Cintia Barranco, Psicóloga`}
  description={s.body.slice(0, 155)}
  path={s.path}
  loaderName={s.title}
  jsonld={[
    serviceSchema(s),
    breadcrumbSchema([
      { name: 'Inicio', path: '/' },
      { name: 'Servicios', path: '/servicios' },
      { name: s.title, path: s.path },
    ]),
  ]}
>
  <nav class="shell crumbs" aria-label="Ruta de navegación">
    <a href="/">Inicio</a>
    <span aria-hidden="true">/</span>
    <a href="/servicios">Servicios</a>
    <span aria-hidden="true">/</span>
    <span class="here">{s.title}</span>
  </nav>

  <ServiceBlock service={s} as="h1" linkOut={false} label={`Servicio ${s.n}`} />

  {/* The individual page is the practice's focus — give it the full concern list
      so a visitor can find their own motivo, not just read a description. */}
  {s.slug === 'terapia-individual' && <ConcernList heading="¿Con qué puedo ayudarte?" />}

  <!-- ---------------------------------------------------------------- cta -- -->
  <section class="shell sect-sm" data-rv>
    <div class="slab">
      <h2>¿Empezamos con una consulta gratuita?</h2>
      <p>
        15 minutos por teléfono o videollamada para contarme qué te preocupa y ver si la {s.title.toLowerCase()}
        es lo que necesitas. Sin compromiso.
      </p>
      <div class="btns">
        <a href="/contacto" class="btn btn-light">Pedir cita</a>
        <a href={site.whatsapp} target="_blank" rel="noopener" class="btn btn-outline-light">
          Escríbeme por WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------------- others -- -->
  <section class="band-top">
    <div class="shell sect-sm">
      <div class="center-head" data-rv>
        <div class="kicker">Otras terapias</div>
        <h2 class="h2-sm">¿Buscabas otra cosa?</h2>
      </div>

      <div class="grid-3" data-rv>
        {
          others.map((o) => (
            <a class="card" href={o.path}>
              <div class="num">{o.n}</div>
              <h3>{o.title}</h3>
              <p>{o.short}</p>
              <span class="arrow">Saber más →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .crumbs {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
    font-size: 13px;
    color: var(--muted);
    padding-top: clamp(24px, 4vw, 40px);
  }
  .crumbs a {
    color: var(--muted);
  }
  .crumbs a:hover {
    color: var(--brand-light);
  }
  .here {
    color: var(--ink);
    font-weight: 600;
  }

  .center-head {
    text-align: center;
    margin-bottom: 40px;
  }
</style>
