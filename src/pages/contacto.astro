---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import { site } from '../data/site';
import { faqSchema, breadcrumbSchema } from '../data/schema';

const faqs = [
  {
    q: '¿Cuánto tardas en responder?',
    a: 'Respondo en menos de 24 horas laborables, tanto por email como por WhatsApp o el formulario.',
  },
  {
    q: '¿Cómo reservo la primera cita?',
    a: 'Escríbeme por WhatsApp, llámame o envía el formulario contándome brevemente tu situación, y buscamos un hueco para una primera conversación sin compromiso.',
  },
  {
    q: '¿Puedo cancelar o cambiar mi cita?',
    a: 'Sí, solo te pido que me avises con al menos 24 horas de antelación para poder reorganizar la agenda.',
  },
  {
    q: '¿Dónde está la consulta?',
    a: 'En Cl. el Guerra, 17, barrio de Beiro, 18014 Granada — una zona tranquila y bien comunicada. También atiendo online desde cualquier lugar.',
  },
] as const;

// No key configured → render the direct-contact panel instead of a form that
// would accept a patient's message and silently discard it.
const formLive = site.web3formsKey.length > 0;
---

<Base
  title="Contacto | Cintia Barranco, Psicóloga en Granada"
  description="Escríbeme sin compromiso por WhatsApp, teléfono o el formulario. Consulta en Cl. el Guerra 17, Granada, y sesiones online en toda España."
  path="/contacto"
  loaderName="Contacto"
  jsonld={[
    faqSchema(faqs),
    breadcrumbSchema([
      { name: 'Inicio', path: '/' },
      { name: 'Contacto', path: '/contacto' },
    ]),
  ]}
>
  <header class="shell-narrow head">
    <div data-rv>
      <div class="kicker">Respondo en menos de 24h</div>
      <h1 class="h1-sm">Contacta con tu psicóloga en Granada</h1>
      <p class="lead">
        Dar el primer paso es lo más importante. Escríbeme sin compromiso y te responderé lo antes
        posible.
      </p>
    </div>
  </header>

  <section class="shell grid" id="formulario">
    <!-- ------------------------------------------------------- left rail -- -->
    <div class="rail" data-rv>
      <div class="intro">
        <img src="/assets/photos/cintia-retrato.jpg" alt={site.name} width="78" height="78" />
        <h2>{site.name}</h2>
        <div class="intro-role">Psicóloga sanitaria · Especializada en vínculos y autoestima</div>
        <div class="tags">
          <span>✓ Presencial u online</span>
          <span>✓ Sin compromiso</span>
        </div>
      </div>

      <div class="card details">
        <a href={`tel:${site.phone}`}>
          <div class="d-label">Teléfono</div>
          <div class="d-val">{site.phoneDisplay}</div>
        </a>
        <a href={`mailto:${site.email}`}>
          <div class="d-label">Email</div>
          <div class="d-val break">{site.email}</div>
        </a>
        <a href={site.mapsLink} target="_blank" rel="noopener">
          <div class="d-label">Dirección</div>
          <div class="d-val">{site.addressLine}</div>
        </a>
        <div class="quick">
          <a href={site.whatsapp} target="_blank" rel="noopener" class="btn btn-wa btn-sm">
            WhatsApp
          </a>
          <a href={`tel:${site.phone}`} class="btn btn-ghost btn-sm">Llámame</a>
        </div>
      </div>
    </div>

    <!-- ------------------------------------------------------------ form -- -->
    <div class="card formcard" data-rv>
      <h2 class="h2-sm">Agenda tu cita</h2>
      <p class="note intro-note">
        Tres pasos rápidos y sin compromiso. Cuando lo envíes, te escribo en menos de 24 horas para
        agendar tu primera cita. ¿Prefieres WhatsApp? También puedes escribirme directamente.
      </p>

      {
        formLive ? (
          <form class="lead-form book" novalidate>
            <input type="hidden" name="access_key" value={site.web3formsKey} />
            <input type="hidden" name="subject" value="Nueva petición de cita desde la web" />
            <input type="hidden" name="from_name" value="Web Cintia Barranco" />
            {/* Honeypot — bots fill it, people never see it. */}
            <input
              type="checkbox"
              name="botcheck"
              class="sr"
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
            />

            {/* Progress — three numbered steps, current one filled. */}
            <ol class="steps" aria-hidden="true">
              <li class="dot on" data-dot="1"><span>1</span></li>
              <li class="dot" data-dot="2"><span>2</span></li>
              <li class="dot" data-dot="3"><span>3</span></li>
            </ol>

            {/* ---------------------------------------------------- paso 1 -- */}
            <fieldset class="step" data-step="1">
              <legend class="step-h">Datos de contacto</legend>
              <div class="two">
                <div class="field">
                  <label for="f-nombre">Nombre *</label>
                  <input id="f-nombre" name="nombre" type="text" required placeholder="Tu nombre" />
                </div>
                <div class="field">
                  <label for="f-apellidos">Apellidos *</label>
                  <input id="f-apellidos" name="apellidos" type="text" required placeholder="Tus apellidos" />
                </div>
              </div>
              <div class="two">
                <div class="field">
                  <label for="f-email">Email *</label>
                  <input id="f-email" name="email" type="email" required placeholder="tu@email.com" />
                </div>
                <div class="field">
                  <label for="f-wa">WhatsApp (con prefijo) *</label>
                  <input id="f-wa" name="whatsapp" type="tel" required placeholder="+34 600 000 000" />
                </div>
              </div>
              <div class="field">
                <span class="group-label">Franja horaria que te vendría mejor</span>
                <div class="chips">
                  <label class="chip"><input type="checkbox" name="disponibilidad" value="Mañanas (10–13h)" /> Mañanas</label>
                  <label class="chip"><input type="checkbox" name="disponibilidad" value="Mediodía (13–16h)" /> Mediodía</label>
                  <label class="chip"><input type="checkbox" name="disponibilidad" value="Tardes (16–20h)" /> Tardes</label>
                  <label class="chip"><input type="checkbox" name="disponibilidad" value="Indiferente" /> Me da igual</label>
                </div>
              </div>
              <div class="booknav">
                <button type="button" class="btn btn-solid next" data-next>Siguiente →</button>
              </div>
            </fieldset>

            {/* ---------------------------------------------------- paso 2 -- */}
            <fieldset class="step" data-step="2" hidden>
              <legend class="step-h">Sobre tu consulta</legend>
              <div class="two">
                <div class="field">
                  <label for="f-tipo">¿Qué tipo de sesión buscas? *</label>
                  <select id="f-tipo" name="tipo" required>
                    <option value="" disabled selected>Elige una opción</option>
                    <option>Terapia individual</option>
                    <option>Terapia de pareja</option>
                    <option>Terapia familiar</option>
                    <option>Aún no lo sé</option>
                  </select>
                </div>
                <div class="field">
                  <span class="group-label">Modalidad *</span>
                  <div class="chips">
                    <label class="chip"><input type="radio" name="modalidad" value="Presencial" required /> Presencial</label>
                    <label class="chip"><input type="radio" name="modalidad" value="Online" /> Online</label>
                    <label class="chip"><input type="radio" name="modalidad" value="Me da igual" /> Me da igual</label>
                  </div>
                </div>
              </div>
              <div class="field">
                <span class="group-label">¿Es tu primera vez en terapia? (opcional)</span>
                <div class="chips">
                  <label class="chip"><input type="radio" name="primera_vez" value="Sí" /> Sí</label>
                  <label class="chip"><input type="radio" name="primera_vez" value="No" /> No, ya he ido antes</label>
                </div>
              </div>
              <div class="booknav two-btn">
                <button type="button" class="btn btn-ghost back" data-back>← Atrás</button>
                <button type="button" class="btn btn-solid next" data-next>Siguiente →</button>
              </div>
            </fieldset>

            {/* ---------------------------------------------------- paso 3 -- */}
            <fieldset class="step" data-step="3" hidden>
              <legend class="step-h">Un último paso</legend>
              <div class="field">
                <label for="f-msg">Si te apetece, cuéntame en una línea qué te trae por aquí (opcional)</label>
                <textarea
                  id="f-msg"
                  name="mensaje"
                  rows="4"
                  placeholder="No hace falta entrar en detalle — con el motivo basta."
                />
              </div>

              {/*
                A booking form on a psychologist's site invites people to describe
                why they need therapy — health data under Art. 9 RGPD. Saying so
                plainly is both the honest thing and the compliant one.
              */}
              <p class="warn">
                Por tu privacidad, no incluyas detalles clínicos o de salud aquí. El resto lo hablamos
                en la primera sesión.
              </p>

              <label class="consent">
                <input type="checkbox" name="consentimiento" required />
                <span>
                  He leído y acepto la <a href="/politica-de-privacidad">política de privacidad</a>.
                </span>
              </label>

              <div class="booknav two-btn">
                <button type="button" class="btn btn-ghost back" data-back>← Atrás</button>
                <button type="submit" class="btn btn-solid submit">Enviar y pedir cita →</button>
              </div>
              <p class="status" role="status" aria-live="polite" hidden />
              <div class="fineprint">Tu mensaje es privado y solo lo leo yo. No comparto tus datos.</div>
            </fieldset>
          </form>
        ) : (
          <div class="nokey">
            <p class="note">
              El formulario todavía no está conectado. Mientras tanto puedes escribirme
              directamente — respondo igual de rápido por cualquiera de estas vías:
            </p>
            <div class="btns">
              <a href={site.whatsapp} target="_blank" rel="noopener" class="btn btn-wa">
                Escríbeme por WhatsApp
              </a>
              <a href={`mailto:${site.email}`} class="btn btn-ghost">Enviar un email</a>
              <a href={`tel:${site.phone}`} class="btn btn-ghost">{site.phoneDisplay}</a>
            </div>
          </div>
        )
      }
    </div>
  </section>

  <!-- ------------------------------------------------------------- mapa -- -->
  <section class="band-top">
    <div class="shell sect-sm">
      <div class="center-head" data-rv>
        <div class="kicker">Ubicación</div>
        <h2 class="h2-sm">¿Dónde encontrarme?</h2>
        <p class="note center-note">
          Mi consulta está en el barrio de Beiro, una zona tranquila y accesible de Granada.
        </p>
      </div>

      {/*
        Click-to-load. Embedding the Google Maps iframe directly would set
        third-party cookies on arrival — prior consent is required under Art. 22.2
        LSSI-CE, and asking for it with a banner just to show a map is a bad trade.
        Pressing the button IS the consent, for that purpose only, and the address
        is fully usable without ever loading it.
      */}
      <div class="map" data-rv data-embed={site.mapsEmbed}>
        <div class="map-ask">
          <div class="map-addr">
            <div class="d-label">Consulta</div>
            <div class="map-street">{site.street}, {site.district}</div>
            <div class="map-city">{site.postal} {site.city}</div>
          </div>
          <p class="map-note">
            El mapa lo carga Google y puede instalar cookies en tu dispositivo. Se muestra solo si
            tú lo pides.
          </p>
          <div class="btns">
            <button type="button" class="btn btn-solid btn-sm map-load">Ver el mapa aquí</button>
            <a href={site.mapsLink} target="_blank" rel="noopener" class="btn btn-ghost btn-sm">
              Abrir en Google Maps →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="band-top">
    <div class="shell-narrow sect-sm">
      <Faq items={faqs} footLink={false} />
    </div>
  </section>
</Base>

<style>
  .head {
    text-align: center;
    padding-top: clamp(56px, 8vw, 86px);
    padding-bottom: clamp(24px, 3vw, 40px);
  }
  .head .lead {
    max-width: 600px;
    margin-inline: auto;
    margin-bottom: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 24px;
    align-items: start;
    padding-top: 40px;
    padding-bottom: clamp(48px, 7vw, 80px);
  }

  .rail {
    display: grid;
    gap: 24px;
  }

  .intro {
    background: var(--brand-dark);
    border-radius: var(--card-lg);
    padding: clamp(28px, 3.4vw, 36px) clamp(24px, 3vw, 34px);
    color: #fff;
    position: relative;
    overflow: hidden;
  }
  .intro::after {
    content: '';
    position: absolute;
    right: -80px;
    top: -80px;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    background: rgba(153, 111, 252, 0.22);
  }
  .intro > * {
    position: relative;
    z-index: 1;
  }
  .intro img {
    width: 78px;
    height: 78px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    margin-bottom: 18px;
    border: 3px solid rgba(255, 255, 255, 0.4);
  }
  .intro h2 {
    font-weight: 500;
    font-size: clamp(22px, 2.4vw, 26px);
    color: #fff;
    margin: 0 0 6px;
  }
  .intro-role {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 18px;
  }
  .tags {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .tags span {
    font-size: 13px;
    font-weight: 500;
    background: rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    padding: 7px 15px;
  }

  .details {
    border-radius: var(--card-lg);
    display: grid;
    gap: 20px;
  }
  .details a {
    display: block;
    color: var(--ink);
  }
  .details a:hover .d-val {
    color: var(--brand);
  }
  .d-label {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 4px;
  }
  .d-val {
    font-size: 17px;
    font-weight: 600;
    transition: color 0.25s;
  }
  .break {
    word-break: break-word;
  }
  .quick {
    display: flex;
    gap: 12px;
    padding-top: 4px;
  }
  .quick .btn {
    flex: 1;
  }

  /* ------------------------------------------------------------- form -- */
  .formcard {
    border-radius: var(--card-lg);
    padding: clamp(28px, 4vw, 44px) clamp(24px, 3.4vw, 42px);
  }
  .intro-note {
    margin: 10px 0 30px;
  }

  .lead-form {
    display: grid;
    gap: 18px;
  }
  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .field {
    display: grid;
    gap: 8px;
  }
  .field label {
    font-size: 14px;
    font-weight: 600;
  }
  .field input,
  .field textarea {
    padding: 14px 18px;
    border-radius: 12px;
    border: 1px solid var(--line-2);
    background: var(--bg);
    font-size: 15px;
    font-family: var(--sans);
    color: var(--ink);
    outline: none;
    transition: border-color 0.2s;
    width: 100%;
  }
  .field textarea {
    resize: vertical;
    min-height: 120px;
  }
  .field input:focus,
  .field textarea:focus {
    border-color: var(--brand-light);
  }
  .field input:user-invalid,
  .field textarea:user-invalid {
    border-color: #c2536b;
  }

  .consent {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 14px;
    color: var(--body);
    cursor: pointer;
  }
  .consent input {
    margin-top: 3px;
    accent-color: var(--brand);
    flex-shrink: 0;
  }

  .warn {
    font-size: 13px;
    line-height: 1.55;
    color: var(--body);
    background: var(--tint);
    border-radius: 12px;
    padding: 12px 16px;
    margin: 0;
  }

  .submit {
    justify-self: start;
  }
  .status {
    margin: 0;
    font-size: 15px;
    border-radius: 12px;
    padding: 14px 18px;
  }
  .status.ok {
    background: #f0f7f2;
    border: 1px solid rgba(76, 175, 125, 0.4);
    color: #2e7d53;
  }
  .status.bad {
    background: #fdf2f4;
    border: 1px solid rgba(194, 83, 107, 0.4);
    color: #a63b52;
  }
  .fineprint {
    font-size: 13px;
    color: var(--muted);
  }

  .nokey .btns {
    margin-top: 20px;
  }

  /* -------------------------------------------------------------- map -- */
  .center-head {
    text-align: center;
    margin-bottom: 44px;
  }
  .center-note {
    max-width: 560px;
    margin-inline: auto;
    font-size: 16px;
  }
  .map {
    border-radius: var(--card-lg);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--tint);
    line-height: 0;
  }
  .map :global(iframe) {
    border: 0;
    display: block;
  }
  .map-ask {
    line-height: 1.6;
    display: grid;
    justify-items: center;
    gap: 18px;
    text-align: center;
    padding: clamp(40px, 7vw, 76px) var(--pad);
  }
  .map-addr {
    display: grid;
    gap: 2px;
  }
  .map-street {
    font-family: var(--serif);
    font-size: clamp(20px, 2.4vw, 26px);
    color: var(--ink);
  }
  .map-city {
    font-size: 15px;
    color: var(--body);
  }
  .map-note {
    font-size: 13px;
    color: var(--muted);
    max-width: 380px;
    margin: 0;
  }

  /* ----------------------------------------------- multi-step booking -- */
  .steps {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0;
    margin: 0 0 32px;
    padding: 0;
  }
  .dot {
    flex: 1;
    display: flex;
    align-items: center;
  }
  .dot span {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 15px;
    font-weight: 600;
    border: 1.5px solid var(--edge-2);
    color: var(--muted);
    background: var(--surface);
    transition: background 0.3s var(--ease), color 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  /* Connector line after every dot but the last. */
  .dot:not(:last-child)::after {
    content: '';
    flex: 1;
    height: 1.5px;
    background: var(--line-2);
    margin: 0 8px;
    transition: background 0.3s var(--ease);
  }
  .dot.on span {
    background: var(--brand);
    border-color: var(--brand);
    color: #fff;
  }
  .dot.done span {
    background: var(--tint);
    border-color: var(--brand);
    color: var(--brand);
  }
  .dot.done::after {
    background: var(--brand-light);
  }

  .step {
    border: 0;
    margin: 0;
    padding: 0;
    min-inline-size: 0;
    display: grid;
    gap: 20px;
    /* Each step animates in when it becomes the active one. */
    animation: stepIn 0.4s var(--ease) both;
  }
  .step[hidden] {
    display: none;
  }
  @keyframes stepIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  .step-h {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
    padding: 0;
    margin-bottom: -4px;
  }

  .group-label {
    font-size: 14px;
    font-weight: 600;
  }
  select {
    padding: 14px 18px;
    border-radius: 12px;
    border: 1px solid var(--line-2);
    background: var(--bg);
    font-size: 15px;
    font-family: var(--sans);
    color: var(--ink);
    outline: none;
    transition: border-color 0.2s;
    width: 100%;
    cursor: pointer;
  }
  select:focus {
    border-color: var(--brand-light);
  }

  /* Selectable chips for the checkbox / radio groups. */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: var(--bg);
    font-size: 14px;
    font-weight: 500;
    color: var(--body);
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s, color 0.2s;
  }
  .chip:hover {
    border-color: var(--edge-2);
  }
  .chip input {
    accent-color: var(--brand);
    margin: 0;
  }
  /* Filled look when checked, via :has (supported in all current browsers). */
  .chip:has(input:checked) {
    border-color: var(--brand);
    background: var(--tint);
    color: var(--brand);
  }

  .booknav {
    display: flex;
    gap: 14px;
    margin-top: 4px;
  }
  .booknav .next,
  .booknav .submit {
    margin-left: auto;
  }
  .booknav.two-btn .back {
    margin-right: auto;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  /* 600, not 480: large phones report ~481–500 CSS px and two inputs side by side
     get cramped there. Forms crowd earlier than cards do. */
  @media (max-width: 600px) {
    .two {
      grid-template-columns: 1fr;
    }
    .quick {
      flex-direction: column;
    }
    .submit {
      justify-self: stretch;
    }
    .booknav {
      flex-direction: column-reverse;
    }
    .booknav .next,
    .booknav .submit,
    .booknav.two-btn .back {
      margin: 0;
      width: 100%;
    }
  }
</style>

<script>
  // ---- map: load Google's iframe only once the visitor asks for it -----------
  const map = document.querySelector<HTMLElement>('.map');
  map?.querySelector<HTMLButtonElement>('.map-load')?.addEventListener('click', () => {
    const frame = document.createElement('iframe');
    frame.src = map.dataset.embed!;
    frame.width = '100%';
    frame.height = '420';
    frame.loading = 'lazy';
    frame.referrerPolicy = 'no-referrer-when-downgrade';
    frame.title = 'Mapa de la consulta de Cintia Barranco en Granada';
    map.replaceChildren(frame);
  });

  // ---- multi-step booking form ----------------------------------------------
  const form = document.querySelector<HTMLFormElement>('form.lead-form.book');

  if (form) {
    const steps = [...form.querySelectorAll<HTMLElement>('.step')];
    const dots = [...form.querySelectorAll<HTMLElement>('.dot')];
    const status = form.querySelector<HTMLParagraphElement>('.status')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const submitLabel = submit.textContent;
    let current = 0;

    const say = (msg: string, ok: boolean) => {
      status.hidden = false;
      status.textContent = msg;
      status.classList.toggle('ok', ok);
      status.classList.toggle('bad', !ok);
    };

    const show = (i: number) => {
      current = i;
      steps.forEach((s, n) => (s.hidden = n !== i));
      dots.forEach((d, n) => {
        d.classList.toggle('on', n === i);
        d.classList.toggle('done', n < i);
      });
      // Bring the form top into view so the next step starts where the eye is.
      form.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      // Focus the first control of the new step for keyboard users.
      steps[i].querySelector<HTMLElement>('input, select, textarea')?.focus({ preventScroll: true });
    };

    // Validate only the fields inside the current step before advancing.
    const stepValid = (i: number) => {
      const fields = steps[i].querySelectorAll<HTMLInputElement>('input, select, textarea');
      for (const f of fields) {
        if (!f.checkValidity()) {
          f.reportValidity();
          return false;
        }
      }
      return true;
    };

    form.querySelectorAll<HTMLButtonElement>('[data-next]').forEach((b) =>
      b.addEventListener('click', () => {
        if (stepValid(current)) show(Math.min(current + 1, steps.length - 1));
      })
    );
    form.querySelectorAll<HTMLButtonElement>('[data-back]').forEach((b) =>
      b.addEventListener('click', () => show(Math.max(current - 1, 0)))
    );

    // Enter on a text field advances the step instead of submitting early.
    form.addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement;
      if (e.key === 'Enter' && t.tagName === 'INPUT' && current < steps.length - 1) {
        e.preventDefault();
        if (stepValid(current)) show(current + 1);
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        // Jump to the first step that still has an invalid field.
        const bad = steps.findIndex((s) =>
          [...s.querySelectorAll<HTMLInputElement>('input, select, textarea')].some(
            (f) => !f.checkValidity()
          )
        );
        if (bad !== -1 && bad !== current) show(bad);
        form.reportValidity();
        return;
      }

      submit.disabled = true;
      submit.textContent = 'Enviando…';

      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: new FormData(form),
        });
        const data = await res.json();
        if (data.success) {
          say(
            'Recibido. Gracias por dar el paso — te escribo en menos de 24 horas para agendar tu primera cita.',
            true
          );
          // Hide the fields, leave the confirmation.
          form.querySelectorAll('.booknav').forEach((n) => ((n as HTMLElement).hidden = true));
        } else {
          say('No se ha podido enviar. Escríbeme por WhatsApp o llámame al 644 21 45 95.', false);
        }
      } catch {
        say('No se ha podido enviar. Escríbeme por WhatsApp o llámame al 644 21 45 95.', false);
      } finally {
        submit.disabled = false;
        submit.textContent = submitLabel;
      }
    });
  }
</script>
