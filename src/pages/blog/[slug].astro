---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { postSchema, breadcrumbSchema } from '../../data/schema';
import { fmtDateLong, readingTime } from '../../lib/format';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;

const related = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
---

<Base
  title={`${d.title} | Cintia Barranco, Psicóloga en Granada`}
  description={d.description}
  path={`/blog/${post.id}`}
  loaderName="Blog"
  image={d.cover}
  jsonld={[
    postSchema({ ...d, slug: post.id }),
    breadcrumbSchema([
      { name: 'Inicio', path: '/' },
      { name: 'Blog', path: '/blog' },
      { name: d.title, path: `/blog/${post.id}` },
    ]),
  ]}
>
  <article>
    <header class="shell-narrow head">
      <nav class="crumbs" aria-label="Ruta de navegación">
        <a href="/blog">← Volver al blog</a>
      </nav>

      <div class="meta">
        <span class="cat">{d.category}</span>
        <span><time datetime={d.date.toISOString()}>{fmtDateLong(d.date)}</time></span>
        <span>{readingTime(post.body ?? '')}</span>
      </div>

      <h1 class="h1-sm">{d.title}</h1>
      <p class="lead">{d.description}</p>
    </header>

    {
      d.cover && (
        <div class="shell cover" data-rv>
          <img src={d.cover} alt={d.coverAlt ?? ''} width="1000" height="750" loading="eager" />
        </div>
      )
    }

    <div class="shell-narrow body">
      <Content />
    </div>

    <footer class="shell-narrow sign">
      <img src="/assets/photos/cintia-retrato.jpg" alt="" width="72" height="72" />
      <div>
        <div class="sign-name">{site.name}</div>
        <div class="sign-role">{site.role} · {site.city}</div>
      </div>
      <a href="/contacto" class="btn btn-solid btn-sm">Pedir cita</a>
    </footer>
  </article>

  {
    related.length > 0 && (
      <section class="band-top">
        <div class="shell sect-sm">
          <h2 class="h2-sm more" data-rv>Sigue leyendo</h2>
          <div class="grid-2" data-rv>
            {related.map((p) => (
              <a class="card" href={`/blog/${p.id}`}>
                <span class="cat">{p.data.category}</span>
                <h3>{p.data.title}</h3>
                <p>{p.data.description}</p>
                <span class="arrow">Leer artículo →</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  .head {
    padding-top: clamp(36px, 5vw, 60px);
    padding-bottom: clamp(24px, 3vw, 36px);
  }
  .crumbs {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 26px;
  }
  .meta {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 18px;
  }
  .cat {
    color: var(--brand-light);
    font-weight: 600;
  }
  .head .lead {
    margin-bottom: 0;
  }

  .cover {
    padding-block: clamp(20px, 3vw, 36px);
  }
  .cover img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 24px;
    display: block;
  }

  /* ---------------------------------------------------------- article -- */
  .body {
    padding-bottom: clamp(40px, 6vw, 64px);
    font-size: clamp(16px, 1.6vw, 17px);
    line-height: 1.75;
    color: var(--body);
  }
  .body :global(h2) {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(24px, 3vw, 32px);
    line-height: 1.2;
    color: var(--ink);
    margin: clamp(36px, 5vw, 52px) 0 16px;
  }
  .body :global(h3) {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(19px, 2.2vw, 23px);
    color: var(--ink);
    margin: 32px 0 12px;
  }
  .body :global(p) {
    margin: 0 0 20px;
  }
  .body :global(ul),
  .body :global(ol) {
    margin: 0 0 24px;
    padding-left: 22px;
  }
  .body :global(li) {
    margin-bottom: 10px;
  }
  .body :global(li::marker) {
    color: var(--lav);
  }
  .body :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }
  .body :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--lav);
  }
  .body :global(blockquote) {
    margin: 32px 0;
    padding: 24px 28px;
    background: var(--tint);
    border-radius: 20px;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(18px, 2vw, 21px);
    line-height: 1.5;
    color: var(--brand);
  }
  .body :global(blockquote p:last-child) {
    margin-bottom: 0;
  }
  .body :global(hr) {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 40px 0;
  }

  /* ------------------------------------------------------------- sign -- */
  .sign {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    padding-top: 28px;
    padding-bottom: clamp(40px, 6vw, 64px);
    border-top: 1px solid var(--line);
  }
  .sign img {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
  }
  .sign > div {
    margin-right: auto;
  }
  .sign-name {
    font-family: var(--serif);
    font-size: 19px;
    color: var(--ink);
  }
  .sign-role {
    font-size: 14px;
    color: var(--muted);
  }

  .more {
    margin-bottom: 28px;
  }
</style>
