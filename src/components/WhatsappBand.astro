---
import { site } from '../data/site';

/**
 * Mid-page WhatsApp strip, ported from the Framer site's "¿Hablamos por WhatsApp?".
 * Worth its own band: in Spain WhatsApp is how people actually make a first contact
 * with a small practice, and until now that CTA only existed in the floating button
 * and the contact slab at the very bottom.
 */
interface Props {
  text?: string;
}
const {
  text = 'A veces puede resultar más fácil dar el paso escribiendo que haciendo una llamada. Cuéntame qué te está ocurriendo y te responderé personalmente para que podamos ver cómo puedo ayudarte.',
} = Astro.props;
---

<section class="wband" data-rv>
  <div class="shell inner">
    <div class="copy">
      <h2>¿Hablamos por WhatsApp?</h2>
      <p>{text}</p>
    </div>
    <a href={site.whatsapp} target="_blank" rel="noopener" class="btn btn-wa go">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
          d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2zm5.4 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5s.8 1.9.8 2c.1.1.1.3 0 .5l-.4.6c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1.1 2.2 1.4 2.5 1.5.3.1.5.1.6-.1s.7-.8.9-1.1c.2-.3.4-.2.6-.1l1.9.9c.2.1.4.2.4.3.1.1.1.6-.1 1.2z"
        ></path>
      </svg>
      Escríbeme ahora
    </a>
  </div>
</section>

<style>
  .wband {
    background: var(--tint);
    border-top: 1px solid var(--hair);
    border-bottom: 1px solid var(--hair);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(20px, 4vw, 48px);
    padding-block: clamp(32px, 5vw, 52px);
  }
  .copy h2 {
    font-weight: 500;
    font-size: clamp(23px, 2.8vw, 32px);
    line-height: 1.2;
    margin: 0 0 8px;
  }
  .copy p {
    font-size: clamp(14px, 1.5vw, 16px);
    line-height: 1.6;
    color: var(--body);
    margin: 0;
    max-width: 520px;
  }
  .go {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  @media (max-width: 760px) {
    .inner {
      flex-direction: column;
      align-items: flex-start;
    }
    .go {
      width: 100%;
      justify-content: center;
    }
  }
</style>
