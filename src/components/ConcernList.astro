---
import { individualConcerns, site } from '../data/site';

/**
 * "Consulta individual" block — the motivos de consulta, in Cintia's own words
 * (see individualConcerns in site.ts). Structure follows her brief: the five she
 * wants to be known for lead as a highlighted "especialidad" (vínculos y
 * relaciones), always visible; the rest sit below in an expandable two-column
 * list. In Cintia's lavender palette, not the reference's monochrome.
 *
 * `as` controls the heading level so this can lead a page (h1) or sit inside one.
 */
interface Props {
  as?: 'h1' | 'h2';
  kicker?: string;
  heading?: string;
}
const { as = 'h2', kicker = 'Consulta individual', heading = 'Un espacio para volver a ti' } =
  Astro.props;
const Heading = as;

const featured = individualConcerns.filter((c) => 'featured' in c && c.featured);
const rest = individualConcerns.filter((c) => !('featured' in c && c.featured));

// Two independent column stacks for the accordion — NOT CSS `columns` (opening a
// <details> inside a multicolumn makes the browser re-balance and report a bogus
// scrollHeight). Two real stacks also let a row push only its own column.
const half = Math.ceil(rest.length / 2);
const columns = [rest.slice(0, half), rest.slice(half)];
---

<section class="ci" id="motivos">
  <div class="shell inner">
    <div class="intro" data-rv>
      <div class="kicker"><span class="rule"></span>{kicker}</div>
      <Heading class={as === 'h1' ? 'h1-sm' : 'h2'}>{heading}</Heading>
      <p class="lead">
        Un espacio íntimo para explorar tu historia, aprender a relacionarte de otra manera con lo
        que sientes y recuperar tu fuerza interna.
      </p>
      <p class="prose sub">
        Trabajamos sin quedarnos en la etiqueta: lo importante no es el nombre del problema, sino
        qué función cumple lo que te pasa y cómo está influyendo en tu vida y en tus relaciones.
      </p>
    </div>

    {/* -------------------------------------------------- especialidad -- */}
    <div class="spec-head" data-rv>
      <div class="tag">Mi especialidad</div>
      <h3 class="spec-title">Vínculos y relaciones</h3>
    </div>
    <div class="feat" data-rv>
      {
        featured.map((c) => (
          <article class="fcard">
            <h4>{c.t}</h4>
            <p>{c.d}</p>
          </article>
        ))
      }
    </div>

    {/* -------------------------------------------------------- también -- */}
    <div class="rest-head" data-rv>
      <h3 class="rest-title">También te acompaño en</h3>
    </div>
    <div class="grid" data-rv>
      {
        columns.map((col) => (
          <div class="col">
            {col.map((c) => (
              <details class="row">
                <summary>
                  <span class="t">{c.t}</span>
                  <span class="sign" aria-hidden="true">
                    <span class="bar" />
                    <span class="bar" />
                  </span>
                </summary>
                <div class="body">
                  <p>{c.d}</p>
                </div>
              </details>
            ))}
          </div>
        ))
      }
    </div>

    <div class="cta" data-rv>
      <a href={site.whatsapp} target="_blank" rel="noopener" class="btn btn-solid">
        Escríbeme por WhatsApp
      </a>
      <a href="/contacto" class="soft">¿Prefieres el formulario? Pide cita aquí →</a>
    </div>
  </div>
</section>

<style>
  .ci {
    background: var(--surface);
    border-top: 1px solid var(--hair);
    border-bottom: 1px solid var(--hair);
    padding-block: clamp(56px, 9vw, 110px);
  }

  .intro {
    max-width: 720px;
    margin-bottom: clamp(44px, 6vw, 68px);
  }
  .intro .lead {
    margin-bottom: 20px;
  }
  .sub {
    margin: 0;
  }

  /* ----------------------------------------------------- especialidad -- */
  .spec-head {
    margin-bottom: 28px;
  }
  .tag {
    display: inline-block;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--brand-dark);
    background: var(--tint);
    border-radius: 999px;
    padding: 6px 14px;
    margin-bottom: 14px;
  }
  .spec-title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(24px, 3vw, 34px);
    color: var(--ink);
  }

  .feat {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: clamp(18px, 2.2vw, 24px);
    margin-bottom: clamp(48px, 7vw, 78px);
  }
  .fcard {
    background: var(--tint);
    border: 1px solid rgba(153, 111, 252, 0.18);
    border-left: 3px solid var(--brand);
    border-radius: 16px;
    padding: clamp(24px, 2.8vw, 30px);
  }
  .fcard h4 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(18px, 1.9vw, 21px);
    color: var(--brand-dark);
    margin: 0 0 10px;
  }
  .fcard p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--body);
    margin: 0;
  }

  /* ---------------------------------------------------------- también -- */
  .rest-head {
    margin-bottom: 18px;
  }
  .rest-title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(20px, 2.2vw, 26px);
    color: var(--ink);
  }

  /* Two independent column stacks so an open row pushes only its own column. */
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 clamp(32px, 5vw, 64px);
    align-items: start;
  }
  .col {
    display: flex;
    flex-direction: column;
  }

  .row {
    border-top: 1px solid var(--line);
  }
  .col .row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .row > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 18px 4px;
    cursor: pointer;
    list-style: none;
    font-family: var(--serif);
    font-size: clamp(16px, 1.8vw, 19px);
    color: var(--ink);
    transition: color 0.25s var(--ease);
  }
  .row > summary::-webkit-details-marker {
    display: none;
  }
  .row:hover > summary,
  .row[open] > summary {
    color: var(--brand-dark);
  }
  .row[open] > summary .t {
    font-style: italic;
  }

  .sign {
    position: relative;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }
  .sign .bar {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    border-radius: 2px;
    background: var(--brand-light);
    transition: transform 0.42s var(--ease), opacity 0.3s var(--ease);
  }
  .sign .bar:first-child {
    transform: translateY(-50%);
  }
  .sign .bar:last-child {
    transform: translateY(-50%) rotate(90deg);
  }
  .row[open] .sign .bar:last-child {
    transform: translateY(-50%) rotate(180deg);
  }
  .row[open] .sign .bar:first-child {
    transform: translateY(-50%) rotate(180deg);
  }

  .body {
    overflow: hidden;
  }
  .body p {
    margin: 0 0 18px;
    padding-right: 24px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--body);
  }

  .cta {
    margin-top: clamp(40px, 6vw, 56px);
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .soft {
    font-size: 15px;
    font-weight: 600;
  }

  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .col + .col .row:first-child {
      border-top: 0;
    }
  }
</style>

<script>
  // Smooth expand for the accordion rows (see FAQ for the same pattern + the
  // content-visibility measurement trap it avoids).
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduced) {
    document.querySelectorAll<HTMLDetailsElement>('.ci details.row').forEach((d) => {
      const summary = d.querySelector('summary')!;
      const body = d.querySelector<HTMLElement>('.body')!;
      let running: Animation | null = null;
      const EASE = 'cubic-bezier(0.32, 0.72, 0, 1)';

      summary.addEventListener('click', (e) => {
        e.preventDefault();
        running?.cancel();
        running = null;
        body.style.height = '';

        if (d.open) {
          const start = body.offsetHeight;
          running = body.animate(
            [
              { height: `${start}px`, opacity: 1 },
              { height: '0px', opacity: 0 },
            ],
            { duration: 240, easing: EASE }
          );
          running.onfinish = () => {
            d.open = false;
            body.style.height = '';
            running = null;
          };
        } else {
          d.open = true;
          const end = body.scrollHeight;
          running = body.animate(
            [
              { height: '0px', opacity: 0 },
              { height: `${end}px`, opacity: 1 },
            ],
            { duration: 340, easing: EASE }
          );
          running.onfinish = () => {
            body.style.height = '';
            running = null;
          };
        }
      });
    });
  }
</script>
