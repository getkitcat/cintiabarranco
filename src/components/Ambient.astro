---
/**
 * Ambient drifting shapes — the motion layer the Framer site used to feel alive.
 *
 * Built from radial-gradients rather than blurred divs on purpose: `filter: blur()`
 * on a 500px element forces a costly offscreen composite every frame, and there are
 * several of these on screen at once. A radial-gradient fading to transparent gives
 * the same softness for free.
 *
 * Only `transform` is animated, so this stays on the compositor and never triggers
 * layout. The layer is inert — aria-hidden, no pointer events — and clips itself
 * rather than the section, so absolutely-positioned content (the hero badge, the
 * slab's corner circle) is never cut off.
 */
interface Props {
  /** hero = larger and more present; soft = a quieter wash for mid-page sections. */
  variant?: 'hero' | 'soft';
}
const { variant = 'soft' } = Astro.props;
---

<div class:list={['ambient', variant]} aria-hidden="true">
  <span class="b b1"></span>
  <span class="b b2"></span>
  <span class="b b3"></span>
  {variant === 'hero' && <span class="b b4"></span>}
</div>

<style>
  .ambient {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .b {
    position: absolute;
    display: block;
    border-radius: 50%;
    will-change: transform;
  }

  /* --------------------------------------------------------------- soft -- */
  .soft .b1 {
    width: 380px;
    height: 380px;
    top: -120px;
    left: -100px;
    background: radial-gradient(circle, rgba(169, 155, 216, 0.28) 0%, rgba(169, 155, 216, 0) 70%);
    animation: drift1 26s ease-in-out infinite;
  }
  .soft .b2 {
    width: 460px;
    height: 460px;
    bottom: -180px;
    right: -140px;
    background: radial-gradient(circle, rgba(217, 209, 239, 0.4) 0%, rgba(217, 209, 239, 0) 70%);
    animation: drift2 32s ease-in-out infinite;
  }
  .soft .b3 {
    width: 300px;
    height: 300px;
    top: 40%;
    right: 18%;
    background: radial-gradient(circle, rgba(106, 91, 196, 0.12) 0%, rgba(106, 91, 196, 0) 70%);
    animation: drift3 38s ease-in-out infinite;
  }

  /* --------------------------------------------------------------- hero -- */
  .hero .b1 {
    width: 520px;
    height: 520px;
    top: -160px;
    left: -140px;
    background: radial-gradient(circle, rgba(169, 155, 216, 0.34) 0%, rgba(169, 155, 216, 0) 70%);
    animation: drift1 24s ease-in-out infinite;
  }
  .hero .b2 {
    width: 600px;
    height: 600px;
    top: 10%;
    right: -220px;
    background: radial-gradient(circle, rgba(217, 209, 239, 0.5) 0%, rgba(217, 209, 239, 0) 70%);
    animation: drift2 30s ease-in-out infinite;
  }
  .hero .b3 {
    width: 340px;
    height: 340px;
    bottom: -140px;
    left: 30%;
    background: radial-gradient(circle, rgba(106, 91, 196, 0.14) 0%, rgba(106, 91, 196, 0) 70%);
    animation: drift3 36s ease-in-out infinite;
  }
  .hero .b4 {
    width: 260px;
    height: 260px;
    top: 22%;
    left: 46%;
    background: radial-gradient(circle, rgba(244, 241, 251, 0.9) 0%, rgba(244, 241, 251, 0) 70%);
    animation: drift4 28s ease-in-out infinite;
  }

  /* Long, slow, non-repeating-looking paths. Nothing lines up with anything else,
     which is what stops it reading as a loop. */
  @keyframes drift1 {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    33% {
      transform: translate3d(60px, 40px, 0) scale(1.08);
    }
    66% {
      transform: translate3d(20px, 80px, 0) scale(0.96);
    }
  }
  @keyframes drift2 {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    40% {
      transform: translate3d(-70px, 50px, 0) scale(1.06);
    }
    70% {
      transform: translate3d(-30px, -40px, 0) scale(0.98);
    }
  }
  @keyframes drift3 {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    50% {
      transform: translate3d(50px, -60px, 0) scale(1.12);
    }
  }
  @keyframes drift4 {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    45% {
      transform: translate3d(-40px, 60px, 0) scale(1.1);
    }
  }

  /* Below ~760px the shapes crowd the copy and cost battery for decoration
     nobody asked for. Keep two, hold them still. */
  @media (max-width: 760px) {
    .b {
      animation: none !important;
    }
    .b3,
    .b4 {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .b {
      animation: none !important;
    }
  }
</style>
