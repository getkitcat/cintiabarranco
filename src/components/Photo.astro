---
/**
 * Practice photography. The originals were 5–10 MB camera JPEGs; scripts/optimize-images.mjs
 * pre-builds a 640/1000/1600 WebP ladder plus a JPEG fallback, and this picks the
 * right rung per viewport. Serving the originals would have cost ~52 MB a page.
 */
interface Props {
  /** Base filename under /assets/photos, without width or extension. */
  name: string;
  alt: string;
  /** Layout class(es): photo-hero | photo-tall | photo-wide | photo-svc */
  variant?: string;
  /** Rendered width hint for the browser's source selection. */
  sizes?: string;
  /** The LCP image on a page should be eager + high priority; everything else lazy. */
  priority?: boolean;
  class?: string;
}
const {
  name,
  alt,
  variant = 'photo-wide',
  sizes = '(max-width: 760px) 100vw, 50vw',
  priority = false,
  class: extra = '',
} = Astro.props;

const base = `/assets/photos/${name}`;
const srcset = [640, 1000, 1600].map((w) => `${base}-${w}.webp ${w}w`).join(', ');

// The width/height attributes must match the variant's real ratio, otherwise the
// box the browser reserves before decoding is the wrong shape and the page jumps.
const ratios: Record<string, number> = {
  'photo-hero': 4.6 / 4,
  'photo-tall': 4.6 / 4,
  'photo-wide': 3 / 4,
  'photo-svc': 3.2 / 4,
};
const w = 1000;
const h = Math.round(w * (ratios[variant] ?? 3 / 4));
---

<picture>
  <source type="image/webp" srcset={srcset} sizes={sizes} />
  <img
    src={`${base}.jpg`}
    alt={alt}
    class:list={['photo', variant, extra]}
    width={w}
    height={h}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : undefined}
  />
</picture>

<style>
  picture {
    display: block;
  }
</style>
