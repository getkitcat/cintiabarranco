---
import '../styles/global.css';
import Head from '../components/Head.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  path: string;
  jsonld?: object[];
  image?: string;
  noindex?: boolean;
  /**
   * Word on the intro curtain. Home passes nothing and gets the logo intro;
   * every other page gets its own name, as the prototype did.
   */
  loaderName?: string;
}
const { title, description, path, jsonld = [], image, noindex, loaderName } = Astro.props;
const brandLoader = !loaderName;
---

<!doctype html>
<html lang="es">
  <head>
    <Head
      title={title}
      description={description}
      path={path}
      jsonld={jsonld}
      image={image}
      noindex={noindex}
    />
  </head>
  <body>
    <a class="skip" href="#main">Saltar al contenido</a>

    {/*
      Intro curtain, ported from the prototype's splash. It lifts on a pure CSS
      animation rather than the prototype's two setTimeouts — a curtain that
      needs JS to leave can strand a visitor on a blank screen if that JS fails,
      and this one covers the whole viewport.
    */}
    <div class="curtain" aria-hidden="true">
      {
        brandLoader ? (
          <>
            <img class="c-logo" src="/assets/logo.png" alt="" width="604" height="160" />
            <div class="c-rule" />
            <div class="c-tag">Psicología · Granada</div>
          </>
        ) : (
          <>
            <div class="c-tag c-tag-top">Cintia Barranco · Psicología</div>
            <div class="c-mask">
              <div class="c-word">{loaderName}</div>
            </div>
            <div class="c-rule" />
          </>
        )
      }
    </div>

    <Nav current={path} />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <a class="wa" href={site.whatsapp} target="_blank" rel="noopener" aria-label="Escríbeme por WhatsApp">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
          d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2zm5.4 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5s.8 1.9.8 2c.1.1.1.3 0 .5l-.4.6c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1.1 2.2 1.4 2.5 1.5.3.1.5.1.6-.1s.7-.8.9-1.1c.2-.3.4-.2.6-.1l1.9.9c.2.1.4.2.4.3.1.1.1.6-.1 1.2z"
        ></path>
      </svg>
    </a>

    <style>
      /* ------------------------------------------------------- curtain -- */
      .curtain {
        position: fixed;
        inset: 0;
        z-index: 100;
        background: var(--bg);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 20px;
        pointer-events: none;
        animation: lift 0.55s ease 1.4s both;
      }
      @keyframes lift {
        to {
          opacity: 0;
          visibility: hidden;
        }
      }

      .c-logo {
        height: clamp(74px, 14vw, 110px);
        width: auto;
        animation:
          logoIn 1s var(--ease) both,
          logoPulse 2.4s ease-in-out 1.1s infinite;
      }
      @keyframes logoIn {
        from {
          opacity: 0;
          transform: scale(0.82);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }
      @keyframes logoPulse {
        0%,
        100% {
          transform: scale(1);
        }
        50% {
          transform: scale(1.04);
        }
      }

      .c-rule {
        height: 2px;
        background: var(--lav);
        border-radius: 2px;
        animation: lineGrow 1.1s var(--ease) 0.35s both;
      }
      @keyframes lineGrow {
        from {
          width: 0;
          opacity: 0;
        }
        to {
          width: 64px;
          opacity: 1;
        }
      }

      .c-tag {
        font-size: 12px;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: var(--muted);
        text-align: center;
        padding-inline: 20px;
        animation: fadeIn 0.8s ease 0.6s both;
      }
      .c-tag-top {
        animation-delay: 0.15s;
      }
      @keyframes fadeIn {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }

      .c-mask {
        overflow: hidden;
        padding: 4px 0;
      }
      .c-word {
        font-family: var(--serif);
        font-style: italic;
        font-weight: 500;
        font-size: clamp(40px, 9vw, 68px);
        line-height: 1.1;
        color: var(--brand);
        animation: splashWord 0.9s var(--ease) 0.1s both;
      }
      @keyframes splashWord {
        from {
          transform: translateY(110%);
        }
        to {
          transform: translateY(0);
        }
      }

      /* ---------------------------------------------------------- fab -- */
      .wa {
        position: fixed;
        right: clamp(16px, 3vw, 28px);
        bottom: clamp(16px, 3vw, 28px);
        z-index: 60;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: var(--wa);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 14px 30px -10px rgba(37, 211, 102, 0.6);
        transition: transform 0.25s;
      }
      .wa:hover {
        transform: scale(1.08);
        color: #fff;
      }

      main {
        /* The nav is fixed and 74px tall; pages start their own spacing below it. */
        padding-top: 74px;
      }

      /* With reduced motion the curtain is skipped outright rather than played
         instantly — there is nothing to see and no reason to flash it. */
      @media (prefers-reduced-motion: reduce) {
        .curtain {
          display: none;
        }
      }
    </style>

    <script>
      // Scroll reveal. Only elements that START below the fold are hidden, so a
      // stalled observer can never leave above-the-fold content invisible.
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const items = document.querySelectorAll<HTMLElement>('[data-rv]');

      if (reduced) {
        items.forEach((el) => el.classList.add('on'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('on');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px -6% 0px' }
        );

        items.forEach((el) => {
          if (el.getBoundingClientRect().top > window.innerHeight * 0.92) {
            el.classList.add('rv');
            io.observe(el);
          } else {
            el.classList.add('on');
          }
        });
      }
    </script>
  </body>
</html>
